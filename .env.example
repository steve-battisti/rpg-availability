# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). Both values are public: they ship in the bundle and
# grant nothing on their own. Every permission is a row-level security policy.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The band passcode itself is NOT set here. It never reaches the browser.
# Set it as an edge function secret — see supabase/README.md.
